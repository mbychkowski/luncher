# Required: GCP Project ID to deploy infrastructure
project_id = "your-gcp-project-id"

# Primary GCP region for resource deployment (Default: us-central1)
region = "us-central1"

# Container Image URL for Cloud Run service deployment
image_url = "us-docker.pkg.dev/cloudrun/container/hello"

# Optional: Identity-Aware Proxy (IAP) + Global Load Balancer + Cloud Endpoints Configuration
# iap_client_id     = "YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com"
# iap_client_secret = "YOUR_OAUTH_CLIENT_SECRET"
# iap_members       = [
#   "user:alice@example.com",
#   "domain:example.com"
# ]
